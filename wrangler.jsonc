{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tombaklepas-analysis",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-12",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/healthz", "/readyz"]
  },
  "routes": [
    {
      "pattern": "analysis.tombaklepas.app",
      "custom_domain": true
    }
  ],
  "vars": {
    "API_ORIGIN": "https://analysis-origin.tombaklepas.app"
  }
}
